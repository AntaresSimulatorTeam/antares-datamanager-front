{
  "name": "antares-datamanager-front",
  "private": true,
  "version": "1.8.0",
  "description": "Pegase web app",
  "type": "module",
  "scripts": {
    "dev": "node scripts/git-info.js && vite",
    "start": "node scripts/git-info.js && vite",
    "test": "vitest",
    "build": "node scripts/git-info.js && tsc -b && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "cy:open": "cypress open",
    "cy:open e2e": "cypress open --e2e",
    "prepare": "husky && husky install",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@design-system-rte/react": "^1.10.0",
    "@floating-ui/react": "^0.26.28",
    "@fontsource-variable/nunito-sans": "^5.2.7",
    "@tanstack/react-table": "^8.20.5",
    "@tanstack/react-virtual": "^3.13.8",
    "@testing-library/user-event": "^14.5.2",
    "clsx": "^2.1.1",
    "i18next": "^23.14.0",
    "mutative": "^1.0.6",
    "oidc-client-ts": "^3.1.0",
    "postcss": "^8.4.39",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.0.3",
    "react-router-dom": "^7.0.2",
    "react-toastify": "^10.0.5",
    "rte-design-system-react": "^0.1.1",
    "uuid": "^11.0.3",
    "vite-plugin-top-level-await": "^1.4.4"
